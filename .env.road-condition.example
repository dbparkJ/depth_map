# Copy this file to .env.road-condition and pass it to Docker Compose:
# docker compose --env-file .env.road-condition -f compose.road-condition.yml up --build

ROAD_CONDITION_WEB_PORT=8080
ROAD_CONDITION_API_PORT=8081
ROAD_CONDITION_MAX_WORKERS=1

# Host directory containing depth_map outputs. It is mounted read-only at /workspace.
# Example request path for ./artifacts/route_a/chunk_0000 is route_a/chunk_0000.
ROAD_CONDITION_WORKSPACE=./artifacts

# Direct API access is optional because the web container proxies /api.
ROAD_CONDITION_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Contract evaluation only. Keep false until authentication and object storage are configured.
ROAD_CONDITION_RIMMS_CONTRACT_INGRESS_ENABLED=false

# Browser key restricted by VWorld to this hostname. The key is intentionally
# delivered to the browser and must therefore be protected by VWorld domain rules.
VWORLD_API_KEY=
VWORLD_DOMAIN=127.0.0.1
